  <required_dna>
    <rule>First-person narrative only ("I", "my").</rule>
    <rule>Plain, unembellished statement of financial facts.</rule>
  </required_dna>
</voice_calibration_engine>
Output draft inside <calibrated_draft> tags.
</tier_2_decision_grade>

